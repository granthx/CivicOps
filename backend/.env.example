# CivicOps AI backend environment reference.
# Copy to backend/.env. Never commit a real .env file or API key.

# --- Runtime ----------------------------------------------------------------
ENVIRONMENT=development

# SQLite is the zero-setup local database. For production, use a managed
# PostgreSQL URL, for example:
# DATABASE_URL=postgresql+psycopg://civicops:password@localhost:5432/civicops
DATABASE_URL=sqlite:///./var/civicops.db
UPLOAD_DIR=./var/uploads
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seeded records are synthetic and labelled as demo data in the API.
SEED_ON_STARTUP=true

# Keep false when using Alembic migrations (recommended). Set true only for
# the fastest local start on a brand-new SQLite database.
AUTO_CREATE_TABLES=false

# --- Authentication and uploads --------------------------------------------
SESSION_HOURS=12
PASSWORD_ITERATIONS=600000
MAX_UPLOAD_MB=8
MAX_IMAGE_PIXELS=25000000
PUBLIC_REPORT_RATE_LIMIT_PER_HOUR=20

# --- Duplicate suggestions --------------------------------------------------
DUPLICATE_RADIUS_M=300
DUPLICATE_WINDOW_HOURS=72
DUPLICATE_MIN_SCORE=35
DUPLICATE_MAX_RESULTS=10

# --- Deterministic priority rules ------------------------------------------
PRIORITY_WEIGHT_LOW=10
PRIORITY_WEIGHT_MODERATE=25
PRIORITY_WEIGHT_HIGH=40
PRIORITY_WEIGHT_CRITICAL=50
PRIORITY_RECURRENCE_STEP=8
PRIORITY_RECURRENCE_CAP=25
PRIORITY_AGE_POINTS_CAP=25
PRIORITY_AGE_CAP_HOURS=120
PRIORITY_THRESHOLD_CRITICAL=62
PRIORITY_THRESHOLD_HIGH=42
PRIORITY_THRESHOLD_MEDIUM=22

# --- Optional Gemini triage -------------------------------------------------
# Leave blank to use the deterministic rules-v1 fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=25
AI_MAX_ATTEMPTS=2
