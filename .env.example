# ---------------------------------------------------------------------------
# CivicOps AI environment reference
#
# Backend: copy the backend section to backend/.env (or keep a single .env at
# the repository root; the API reads backend/.env first, then this location).
# Frontend: copy NEXT_PUBLIC_API_URL to frontend/.env.local. Next.js does not
# read the backend .env files.
#
# Never commit a real .env file or any API key.
# ---------------------------------------------------------------------------

# --- Backend: runtime -------------------------------------------------------
ENVIRONMENT=development

# SQLite is the zero-setup local database. For production, use a managed
# PostgreSQL URL, for example:
# DATABASE_URL=postgresql+psycopg://civicops:password@localhost:5432/civicops
DATABASE_URL=sqlite:///./var/civicops.db
UPLOAD_DIR=./var/uploads
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# The backend seeds synthetic demo data only when the database has no users.
# Set to false for any non-demo deployment.
SEED_ON_STARTUP=true

# Keep false when using Alembic migrations (recommended). Set true only for
# the fastest local start on a brand-new SQLite database.
AUTO_CREATE_TABLES=false

# --- Backend: authentication and uploads -----------------------------------
SESSION_HOURS=12
PASSWORD_ITERATIONS=600000
MAX_UPLOAD_MB=8
MAX_IMAGE_PIXELS=25000000
PUBLIC_REPORT_RATE_LIMIT_PER_HOUR=20

# --- Backend: duplicate suggestions ----------------------------------------
DUPLICATE_RADIUS_M=300
DUPLICATE_WINDOW_HOURS=72
DUPLICATE_MIN_SCORE=35
DUPLICATE_MAX_RESULTS=10

# --- Backend: spatial-temporal hotspot clustering --------------------------
HOTSPOT_RADIUS_M=150
HOTSPOT_WINDOW_DAYS=30
HOTSPOT_MIN_INCIDENTS=2
PRIORITY_HOTSPOT_BOOST=15

# --- Backend: deterministic priority rules ---------------------------------
# Severity points: low / moderate / high / critical.
PRIORITY_WEIGHT_LOW=10
PRIORITY_WEIGHT_MODERATE=25
PRIORITY_WEIGHT_HIGH=40
PRIORITY_WEIGHT_CRITICAL=50
# Each additional linked report adds this many points, capped below.
PRIORITY_RECURRENCE_STEP=8
PRIORITY_RECURRENCE_CAP=25
# Age reaches its cap at PRIORITY_AGE_CAP_HOURS.
PRIORITY_AGE_POINTS_CAP=25
PRIORITY_AGE_CAP_HOURS=120
# 0-100 score bands.
PRIORITY_THRESHOLD_CRITICAL=62
PRIORITY_THRESHOLD_HIGH=42
PRIORITY_THRESHOLD_MEDIUM=22

# --- Backend: optional Gemini triage ---------------------------------------
# Leave blank to use the deterministic rules-v1 fallback. A configured key is
# tried first; failures fall back safely without blocking report persistence.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=25
AI_MAX_ATTEMPTS=2

# Optional offline speech-to-text fallback (requires faster-whisper).
LOCAL_STT_ENABLED=false
LOCAL_STT_MODEL=base

# Optional automated SLA sweep & outbound webhook alerts (0 disables background loop).
SLA_SWEEP_INTERVAL_SECONDS=0
ALERT_WEBHOOK_URL=

# --- Frontend: copy to frontend/.env.local ---------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api
